# Local backend (start_backend.sh uses port 8005).
# On Vercel, leave this unset (or empty) so the browser calls same-origin /api
# and vercel.json proxies to Railway. Do not set this to *.up.railway.app —
# Railway's edge CORS will block the Vercel origin ("Failed to fetch").
VITE_API_BASE_URL=http://localhost:8005
